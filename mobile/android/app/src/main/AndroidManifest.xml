<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.budgetcontrol.app"
    android:versionCode="1"
    android:versionName="1.0">

    <!-- min/target SDK sont passes a aapt2 au moment du link. -->

    <!--
      AUCUNE permission declaree.
      Pas de android.permission.INTERNET : l'application ne peut ouvrir aucun
      socket reseau. Les assets sont servis en interne (WebViewClient), jamais
      via le reseau. Fonctionne a l'identique en mode avion.
    -->

    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:allowBackup="true"
        android:usesCleartextTraffic="false"
        android:hardwareAccelerated="true"
        android:supportsRtl="true">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:configChanges="orientation|screenSize|keyboardHidden|screenLayout">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
