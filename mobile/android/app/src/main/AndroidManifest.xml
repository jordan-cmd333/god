<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.budgetcontrol.app"
    android:versionCode="1"
    android:versionName="1.0">

    <!-- min/target SDK sont passes a aapt2 au moment du link. -->

    <!--
      Pas de android.permission.INTERNET : l'application ne peut ouvrir aucun
      socket reseau. Les assets sont servis en interne (WebViewClient), jamais
      via le reseau. Fonctionne a l'identique en mode avion.

      Seule permission declaree : POST_NOTIFICATIONS (Android 13+), demandee a la
      demande de l'utilisateur pour les rappels quotidiens. N'ouvre aucun reseau.
    -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:allowBackup="true"
        android:usesCleartextTraffic="false"
        android:hardwareAccelerated="true"
        android:supportsRtl="true">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:launchMode="singleTop"
            android:configChanges="orientation|screenSize|keyboardHidden|screenLayout">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Raccourcis « ecran d'accueil » (appui long sur l'icone). -->
            <meta-data
                android:name="android.app.shortcuts"
                android:resource="@xml/shortcuts" />
        </activity>

        <!-- Rappels quotidiens : recoit l'alarme et poste la notification. -->
        <receiver android:name=".ReminderReceiver" android:exported="false" />
    </application>
</manifest>
